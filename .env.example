# Learning OS - Environment Configuration Example

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=production

# Database
# Local development currently uses data/learning_os.db through SQLite.
# Vercel requires a persistent external PostgreSQL-compatible database after
# the repositories are migrated from SQLite.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Google Drive OAuth (Read-Only)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_DRIVE_FOLDER_ID=1p5n-lsYEDVSCliHMIhVKJxbdH46GnpBP

# AI Gateway Configuration
AI_PROVIDER=rule_based # Options: rule_based, gemini, anthropic, openai, local
AI_MODEL_NAME=gemini-2.5-flash
AI_API_KEY=
